{
  "name": "patterdraw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PatterDraw: an offline-first, student-safe whiteboard with frame slides and PDF annotation.",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:release-isolation": "node scripts/test-package-release-isolation.mjs",
    "test:release-tooling": "node --test deploy/release-inventory.test.mjs deploy/deploy-config-inventory.test.mjs && npm run test:release-isolation && node deploy/verify-config.mjs --config-only",
    "test:browser": "playwright test",
    "test:browser:production": "playwright test --config=playwright.production.config.ts",
    "test:watch": "vitest",
    "release:package": "node scripts/package-release.mjs --build",
    "release:verify": "node scripts/package-release.mjs --verify",
    "check:safety": "node scripts/check-offline-safety.mjs",
    "check:browser-types": "tsc -p tsconfig.browser.json",
    "check": "npm run test && npm run test:release-tooling && npm run build && npm run check:browser-types && npm run check:safety"
  },
  "dependencies": {
    "@excalidraw/common": "0.18.0-e9c856d",
    "@excalidraw/element": "0.18.0-e9c856d",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/math": "0.18.0-e9c856d",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "jszip": "3.10.1",
    "mathjax": "4.1.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "perfect-freehand": "1.2.0",
    "points-on-curve": "1.0.1",
    "pptxgenjs": "file:vendor/pptxgenjs-browser",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.2",
    "@playwright/test": "1.59.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "dompurify": "3.4.13",
    "lodash-es": "4.18.1",
    "mermaid": "11.16.1",
    "points-on-path": "0.2.1",
    "postcss": "8.5.25",
    "undici": "7.29.0"
  }
}
