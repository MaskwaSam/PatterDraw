{
  "name": "excalidraw-classroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, student-safe Excalidraw with frame slides and PDF annotation.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "check:safety": "node scripts/check-offline-safety.mjs",
    "check": "npm run test && npm run build && npm run check:safety"
  },
  "dependencies": {
    "@excalidraw/element": "0.18.0-e9c856d",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/math": "0.18.0-e9c856d",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "mathjax": "4.1.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "points-on-curve": "1.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.8"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.0.9"
    },
    "lodash-es": "4.18.1"
  }
}
